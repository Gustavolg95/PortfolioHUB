# ============================================================
# .gitignore - PortfolioHUB
# ============================================================

# ----------------------------
# Sistema Operacional
# ----------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory

# ----------------------------
# Dados Sensíveis e Segurança
# ----------------------------
# Variáveis de ambiente (NUNCA subir ao GitHub)
.env
.env.local
.env.development
.env.production
.env.test
*.env

# Chaves e tokens de API
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
api_keys.txt
tokens.txt

# Configurações locais privadas
config.local.*
settings.local.*

# ----------------------------
# Editores de Código
# ----------------------------
# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains (IntelliJ, PyCharm, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ----------------------------
# Linguagens e Frameworks
# ----------------------------
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm

# ----------------------------
# Arquivos Temporários e Logs
# ----------------------------
*.log
*.tmp
*.temp
*.bak
*.cache
*.pid
*.seed
*.pid.lock
logs/
temp/
tmp/

# ----------------------------
# Arquivos de Build
# ----------------------------
dist/
build/
out/
.cache/
coverage/

# ----------------------------
# Arquivos Grandes / Mídia
# ----------------------------
# Vídeos (muito grandes para o GitHub)
*.mp4
*.mov
*.avi
*.mkv
*.wmv

# Arquivos compactados grandes
*.zip
*.tar.gz
*.rar
*.7z

# ============================================================
# Nota: Certificados em PDF estão na pasta /certificados/
# e são permitidos pois são documentos públicos do portfólio
# ============================================================